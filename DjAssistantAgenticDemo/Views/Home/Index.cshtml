@model HomeModel
@{ ViewData["Title"] = "Now Playing"; }

<div class="row g-4">
  <!-- Compact Now Playing Section -->
  <div class="col-12 col-lg-4 col-xl-3">
    <div class="card now-playing-form sticky-top" style="top: 20px;">
      <h2 class="h4">🎵 Now Playing</h2>
      <p class="text-muted small">Add a song to the queue</p>

      <form asp-action="Add" method="post">
        @Html.AntiForgeryToken()
        <div class="mb-3">
          <label asp-for="Text" class="form-label fw-bold small">Song Description</label>
          <textarea asp-for="Text" class="form-control" rows="3" placeholder="e.g., Mother by Pink Floyd"></textarea>
          <span asp-validation-for="Text" class="text-danger small"></span>
        </div>
        <button class="btn btn-primary w-100" type="submit">
          ✨ Add &amp; Enrich
        </button>
      </form>

      <div class="mt-3 d-flex gap-2 flex-wrap">
        <a class="btn btn-sm btn-outline-secondary flex-grow-1" asp-action="History">
          📜 History
        </a>
        <a class="btn btn-sm btn-outline-primary flex-grow-1" href="#suggestions">
          💡 Suggestions
        </a>
      </div>
    </div>
  </div>

  <!-- Expanded Suggestions Section -->
  <div class="col-12 col-lg-8 col-xl-9">
    <div id="suggestions">
      @await Html.PartialAsync("~/Views/Home/Suggestions.cshtml", Model.Suggestions)
    </div>
  </div>
</div>

@section Scripts {
  <partial name="_ValidationScriptsPartial" />
}
